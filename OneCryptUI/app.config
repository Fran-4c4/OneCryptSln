<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog"/>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <appSettings>
    <!-- Empty disables update checks. Set only to an absolute HTTPS XML feed. -->
    <add key="OneCrypt.UpdateFeedUrl" value="" />
  </appSettings>
  <connectionStrings>
    <add name="My.MySettings.oneCryptDatabaseConnectionString" connectionString="Data Source=|DataDirectory|"
      providerName="Microsoft.SqlServerCe.Client.4.0" />
  </connectionStrings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
  
  <nlog autoReload="true" xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" >

    <targets>
      <target name="file" xsi:type="File"
          layout="${longdate} ${logger} ${message}"
          fileName="${basedir}/logs/OneCryptLog.log"
          keepFileOpen="false"
          encoding="iso-8859-2" />
    </targets>

    <rules>
      <logger name="*" minlevel="Debug" writeTo="file" />
    </rules>
  </nlog>
  <userSettings>
    <My.MySettings>
      <setting name="CryptListViewColumnWidth" serializeAs="String">
        <value>200|350|65|40</value>
      </setting>
    </My.MySettings>
  </userSettings>
</configuration>
